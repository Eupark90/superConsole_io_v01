{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Debug"
            ],
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Upload Debug",
            "type": "shell",
            "command": "/opt/homebrew/bin/openocd",
            "args": [
                "-f",
                "interface/stlink.cfg",
                "-f",
                "target/stm32f0x.cfg",
                "-c",
                "program ${workspaceFolder}/build/Debug/superConsoleV01_IO.elf verify reset exit"
            ],
            "dependsOn": "Build Debug",
            "problemMatcher": []
        }
    ]
}
